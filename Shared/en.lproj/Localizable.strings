"help.windowTitle" = "AI Usage Help";
"help.title" = "About stale data";
"help.intro" = "Stale means AI Usage cannot confirm that the displayed values are current. It can appear after collection fails, when the observation time is missing or invalid, or when the last valid observation is more than six hours old.";
"help.warning" = "The badge alone does not show that a quota was exceeded or an account is invalid. Usage and reset times shown while stale may no longer be current.";
"help.collectionNote.format" = "Last collection note: %@";
"help.observed.format" = "Observed: %@";
"help.lastChecked.format" = "Last checked: %@";
"help.checkedExplanation" = "“Last checked” is when AI Usage attempted a refresh. A recent check can remain stale if no new valid values were obtained.";
"help.steps" = "What to try";
"help.claude.title" = "Claude Code";
"help.claude.body" = "AI Usage refreshes Claude credentials automatically near expiry. If it reports that refresh failed, sign in to Claude Code again, then choose Check Again. Also check your network and Keychain permission. For the statusLine source, complete a normal response in terminal Claude Code. Wait if rate-limited.";
"help.codex.title" = "Codex";
"help.codex.body" = "Complete a normal Codex response, then check again. Checking again does not update the local session log by itself.";
"help.grok.title" = "Grok";
"help.grok.body" = "Use Grok normally so it can update its local billing log, then check again.";
"help.widget.body" = "Opening the widget alone does not collect data. Open the AI Usage app and check again.";
"help.checkAgain.detail" = "Checking again retries collection, but it cannot force Codex or Grok to write new logs or bypass a provider's rate limit.";
"help.privacy" = "For support, do not share OAuth tokens, Keychain contents, complete session logs, or raw statusLine logs.";

